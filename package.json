{
  "name": "geopolitics",
  "version": "0.1.0",
  "private": true,
  "description": "Risk-inspired browser game for the UCT INF4001N entrance project",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --project demo-geopolitics",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-geopolitics \"vitest run -c vitest.integration.config.js\"",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
